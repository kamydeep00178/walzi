<?xml version="1.0" encoding="utf-8"?>
<!--
    res/layout/native_ad_item.xml
    Native ad row - dark, matching the app (Surface / TextPrimary / TextSecondary colors).
    Policy: keeps the visible "Ad" label; the AdChoices icon (ad_choices) sits top-right, and
    the row has extra top padding to keep it clear of the CTA. Root MUST be NativeAdView.
-->
<com.google.android.gms.ads.nativead.NativeAdView
    android:theme="@style/Theme.Walzi.Splash"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/native_ad_view"
    android:background="#15151B"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <!-- FrameLayout so the AdChoices icon can sit in the top-right corner above the row. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="18dp"
        android:paddingBottom="12dp"
        android:gravity="center_vertical">

        <!-- App icon -->
        <ImageView
            android:id="@+id/ad_app_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:scaleType="centerCrop"
            android:background="@drawable/bg_icon_circle"
            android:padding="2dp"
            android:layout_marginEnd="12dp"
            android:contentDescription="Ad icon"/>

        <!-- Text block -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Ad badge + headline row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="2dp">

                <!-- "Ad" orange pill -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ad"
                    android:textSize="9sp"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:background="@drawable/bg_ad_badge"
                    android:paddingStart="5dp"
                    android:paddingEnd="5dp"
                    android:paddingTop="1dp"
                    android:paddingBottom="1dp"
                    android:layout_marginEnd="6dp"/>

                <!-- Headline -->
                <TextView
                    android:id="@+id/ad_headline"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#F4F4F6"
                    android:maxLines="1"
                    android:ellipsize="end"/>
            </LinearLayout>

            <!-- Body -->
            <TextView
                android:id="@+id/ad_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="#9494A0"
                android:maxLines="2"
                android:ellipsize="end"/>

        </LinearLayout>

        <!-- CTA button — always white text on blue bg -->
        <TextView
            android:id="@+id/ad_call_to_action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:textSize="10sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:background="@drawable/bg_cta_button"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:maxLines="1"
            android:minWidth="56dp"
            android:gravity="center"/>

    </LinearLayout>

    <!-- Required AdChoices icon, registered explicitly so it always renders here (top-right,
         clear of the CTA thanks to the row's top padding). Must never be covered. -->
    <com.google.android.gms.ads.nativead.AdChoicesView
        android:id="@+id/ad_choices"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end" />

    </FrameLayout>

</com.google.android.gms.ads.nativead.NativeAdView>